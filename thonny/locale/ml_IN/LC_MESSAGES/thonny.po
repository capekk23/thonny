#: thonny/plugins/aia
msgid "The assistant is loafing around..."
msgstr "സഹായി അലസമായിരിക്കുന്നു..."

#: thonny/plugins/aia
msgid "The assistant is out for lunch..."
msgstr "സഹായി ഉച്ചഭക്ഷണത്തിന് പോയി..."

#: thonny/plugins/aia
msgid "The assistant is having a coffee..."
msgstr "സഹായി കാപ്പി കുടിക്കുന്നു..."

#: thonny/plugins/aia
msgid "The assistant is reading a book..."
msgstr "സഹായി ഒരു പുസ്തകം വായിക്കുന്നു..."

#: thonny/plugins/aia
msgid "The assistant is looking out of the window..."
msgstr "സഹായി ജനാലയിലൂടെ പുറത്തേക്ക് നോക്കുന്നു..."

#: thonny/plugins/aia
msgid "The assistant is stretching..."
msgstr "സഹായി മൂരി നിവർത്തുന്നു..."

#: thonny/plugins/aia
msgid "The assistant is waking up..."
msgstr "സഹായി ഉണരുന്നു..."

#: thonny/plugins/aia
msgid "Model:"
msgstr "മോഡൽ:"

#: thonny/plugins/aia
msgid "%s (default)"
msgstr "%s (സ്ഥിരസ്ഥിതി)"

#: thonny/plugins/aia
msgid "Enter the API key to see the models it can use."
msgstr "ഈ കീക്ക് ഉപയോഗിക്കാവുന്ന മോഡലുകൾ കാണാൻ API കീ നൽകൂ."

#: thonny/plugins/aia
msgid "Asking the provider for the models of this key..."
msgstr "ഈ കീയുടെ മോഡലുകൾ ദാതാവിനോട് ചോദിക്കുന്നു..."

#: thonny/plugins/aia
msgid "The models this key can use."
msgstr "ഈ കീക്ക് ഉപയോഗിക്കാവുന്ന മോഡലുകൾ."

#: thonny/plugins/aia
msgid "The provider did not list the models of this key; these are the usual ones."
msgstr "ദാതാവ് ഈ കീയുടെ മോഡലുകൾ പട്ടികപ്പെടുത്തിയില്ല; ഇവ സാധാരണ മോഡലുകളാണ്."

#: thonny/plugins/aia
msgid "The model %s is not available. Choose another model in Tools > Options > AI Assistant."
msgstr "മോഡൽ %s ലഭ്യമല്ല. ഉപകരണങ്ങൾ > ഐച്ഛികങ്ങൾ > AI സഹായി എന്നതിൽ മറ്റൊരു മോഡൽ തിരഞ്ഞെടുക്കൂ."

#: thonny/plugins/aia
msgid "AIA sends your messages, the code from the editor (and, if switched on in the options, the files it imports) and error output to the AI provider you choose. The local model sends nothing outside your computer."
msgstr "AIA നിങ്ങളുടെ സന്ദേശങ്ങൾ, എഡിറ്ററിലെ കോഡ് (ഐച്ഛികങ്ങളിൽ ഓണാക്കിയിട്ടുണ്ടെങ്കിൽ, ആ കോഡ് ഇംപോർട്ട് ചെയ്യുന്ന ഫയലുകളും), പിഴവ് ഔട്ട്പുട്ട് എന്നിവ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന AI ദാതാവിന് അയയ്ക്കുന്നു. പ്രാദേശിക മോഡൽ നിങ്ങളുടെ കമ്പ്യൂട്ടറിന് പുറത്തേക്ക് ഒന്നും അയയ്ക്കുന്നില്ല."

#: thonny/plugins/aia
msgid "Thonny AIA is an unofficial fork. It is not published or supported by the Thonny project or the University of Tartu."
msgstr "Thonny AIA ഒരു അനൗദ്യോഗിക ഫോർക്ക് ആണ്. Thonny പ്രോജക്റ്റോ ടാർട്ടു സർവകലാശാലയോ ഇത് പ്രസിദ്ധീകരിക്കുകയോ പിന്തുണയ്ക്കുകയോ ചെയ്യുന്നില്ല."

#: thonny/plugins/aia
msgid "Thonny was created by %s."
msgstr "Thonny സൃഷ്ടിച്ചത് %s ആണ്."

#: thonny/plugins/aia
msgid "The intelligent assistant AIA was created by %s."
msgstr "ബുദ്ധിയുള്ള സഹായി AIA സൃഷ്ടിച്ചത് %s ആണ്."

#: thonny/plugins/aia
msgid "(the AI assistant AIA and the changes of Thonny AIA)"
msgstr "(AI സഹായി AIA-യും Thonny AIA-യിലെ മാറ്റങ്ങളും)"
